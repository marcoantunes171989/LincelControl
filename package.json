{
  "name": "licencontrol",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:web": "vite",
    "dev:server": "npm run dev --prefix server",
    "dev:all": "npm run dev:server",
    "build": "tsc -b && vite build",
    "build:web": "tsc -b && vite build",
    "build:server": "npm run build --prefix server",
    "build:all": "tsc -b && vite build && npm run build --prefix server",
    "lint": "oxlint && npm run lint --prefix server",
    "test": "vitest run && npm run test --prefix server",
    "test:web": "vitest run",
    "test:server": "npm run test --prefix server",
    "test:watch": "vitest",
    "preview": "vite preview",
    "start:server": "npm run start --prefix server"
  },
  "dependencies": {
    "lucide-react": "^1.25.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/ui": "^4.1.10",
    "jsdom": "^29.1.1",
    "oxlint": "^1.71.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
