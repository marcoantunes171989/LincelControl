# Frontend (Vite)
VITE_API_BASE_URL=
VITE_ADMIN_API_KEY=

# API interna
PORT=8787
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
ADMIN_API_KEY=
DATA_DIR=

# Oracle Client / TNS
ORACLE_CLIENT_LIB_DIR=C:\Oracle\instantclient_19_25
ORACLE_TNS_ADMIN=\\SERVIDOR-ARQUIVOS\Oracle\Network\Admin
ORACLE_TNS_FILE_NAME=tnsnames.ora
ORACLE_TNSPING_PATH=C:\Oracle\instantclient_19_25\tnsping.exe

# Timeouts
ORACLE_TCP_TIMEOUT_MS=5000
ORACLE_TNSPING_TIMEOUT_MS=10000
ORACLE_DB_CALL_TIMEOUT_MS=10000
ORACLE_QUEUE_TIMEOUT_MS=5000
ORACLE_TNS_READ_TIMEOUT_MS=5000
ORACLE_POOL_CLOSE_TIMEOUT_MS=10000

# Pool
ORACLE_POOL_MIN=0
ORACLE_POOL_MAX=5
ORACLE_POOL_INCREMENT=1
ORACLE_POOL_TIMEOUT=60
ORACLE_POOL_ALIAS=license-control-oracle

# Segurança / consultas
ORACLE_ALLOW_RAW_SQL=false
ORACLE_MAX_ROWS=100
ORACLE_RATE_LIMIT_WINDOW_MS=60000
ORACLE_RATE_LIMIT_MAX=20
ORACLE_PASSWORD_ATTEMPT_WINDOW_MS=300000
ORACLE_PASSWORD_ATTEMPT_MAX=5
