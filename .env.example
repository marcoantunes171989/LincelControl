# Frontend (Vite)
VITE_API_BASE_URL=
VITE_ADMIN_API_KEY=

# API interna (LicenControl Oracle Agent) — obrigatórias
PORT=8787
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
# ADMIN_API_KEY é obrigatória em produção (NODE_ENV=production); em
# desenvolvimento, se vazia, o acesso local é liberado com permissões de admin.
ADMIN_API_KEY=
# DATA_DIR: opcional. Padrão: server/data. Guarda config Oracle (sem senha) e o TNS importado.
DATA_DIR=
# ORACLE_AGENT_HOST: opcional. Padrão 127.0.0.1 — a API não deve ser exposta
# fora da máquina do operador. Só altere com decisão explícita e consciente do risco.
ORACLE_AGENT_HOST=127.0.0.1

# TNS — opcionais. O fluxo principal importa o tnsnames.ora pela UI (Oracle
# Logon) e não depende destas variáveis; elas só ajudam quem prefere apontar
# para uma pasta/UNC já existente sem precisar importar o arquivo.
ORACLE_TNS_ADMIN=
ORACLE_TNS_FILE_NAME=tnsnames.ora

# Diagnóstico opcional (NÃO obrigatório) — o driver node-oracledb usado pelo
# projeto é o Thin Mode: NÃO precisa de Oracle Instant Client / OCI.DLL para
# conectar. ORACLE_CLIENT_LIB_DIR e ORACLE_TNSPING_PATH são legados/diagnóstico:
# só têm efeito se você quiser rodar tnsping.exe como checagem extra de rede.
ORACLE_CLIENT_LIB_DIR=
ORACLE_TNSPING_PATH=

# Timeouts
ORACLE_TCP_TIMEOUT_MS=5000
ORACLE_TNSPING_TIMEOUT_MS=10000
ORACLE_DB_CALL_TIMEOUT_MS=10000
ORACLE_QUEUE_TIMEOUT_MS=5000
ORACLE_TNS_READ_TIMEOUT_MS=5000
ORACLE_POOL_CLOSE_TIMEOUT_MS=10000

# Pool
ORACLE_POOL_MIN=0
ORACLE_POOL_MAX=5
ORACLE_POOL_INCREMENT=1
ORACLE_POOL_TIMEOUT=60
ORACLE_POOL_ALIAS=license-control-oracle

# Segurança / consultas
ORACLE_ALLOW_RAW_SQL=false
ORACLE_MAX_ROWS=100
ORACLE_RATE_LIMIT_WINDOW_MS=60000
ORACLE_RATE_LIMIT_MAX=20
ORACLE_PASSWORD_ATTEMPT_WINDOW_MS=300000
ORACLE_PASSWORD_ATTEMPT_MAX=5

# Aplicação de licença (preview/apply na TAB_LOJA)
# ORACLE_PREVIEW_TOKEN_SECRET: opcional. Se vazio, um segredo aleatório é gerado
# em memória a cada início do processo (suficiente, pois o token expira rápido).
ORACLE_PREVIEW_TOKEN_SECRET=
ORACLE_PREVIEW_TOKEN_TTL_MS=300000
